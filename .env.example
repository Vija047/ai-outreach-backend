# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated extra CORS origins (e.g. Vercel preview URLs)
CORS_ORIGINS=

# Database — Neon PostgreSQL (production)
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_outreach?schema=public

# Redis — Upstash (production)
# Prefer a full REDIS_URL from Upstash Connect (Node.js tab)
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379
# Optional alternative to REDIS_URL (both host + password required):
# UPSTASH_REDIS_HOST=
# UPSTASH_REDIS_PASSWORD=

# Auth — use a strong random secret in production (openssl rand -base64 64)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Production callback: https://YOUR-API.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Email Verification — Gmail SMTP (default)
# Render FREE tier blocks SMTP ports 587/465 → upgrade to Starter ($7/mo) or use BYPASS_EMAIL_VERIFICATION
EMAIL_PROVIDER=smtp
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=AI Outreach <your@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use for Gmail SSL: SMTP_PORT=465 and SMTP_SECURE=true
SMTP_SECURE=false
OTP_EXPIRY_MINUTES=10

# Verification bypass option (recommended for Render Free tier)
BYPASS_EMAIL_VERIFICATION=false

# AI & external services
# OpenRouter: use sk-or-v1-... key + base URL below (or auto-detected from key prefix)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_HTTP_REFERER=http://localhost:3000
OPENAI_APP_TITLE=AI Outreach
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
ROCKETREACH_API_KEY=
HUNTER_API_KEY=
CONTACTS_CACHE_DAYS=30

# Credits
SIGNUP_CREDITS=20
ANALYZE_CREDIT_COST=1
GENERATE_CREDIT_COST=1
