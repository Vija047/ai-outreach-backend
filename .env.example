# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated extra CORS origins (e.g. Vercel preview URLs)
CORS_ORIGINS=

# Database — Neon PostgreSQL (production)
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_outreach?schema=public

# Redis — Upstash (production)
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Auth — use a strong random secret in production (openssl rand -base64 64)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Email OTP — Resend (https://resend.com, free tier)
RESEND_API_KEY=
EMAIL_FROM=AI Outreach <onboarding@resend.dev>
OTP_EXPIRY_MINUTES=10

# AI & external services
# OpenRouter: use sk-or-v1-... key + base URL below (or auto-detected from key prefix)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_HTTP_REFERER=http://localhost:3000
OPENAI_APP_TITLE=AI Outreach
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
ROCKETREACH_API_KEY=
HUNTER_API_KEY=
CONTACTS_CACHE_DAYS=30

# Credits
SIGNUP_CREDITS=20
ANALYZE_CREDIT_COST=1
GENERATE_CREDIT_COST=1
